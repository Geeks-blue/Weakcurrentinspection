/* 弱电巡检小程序 - 全局样式 */
page {
  background: #eef3f9;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', sans-serif;
  color: #13223a;
}

/* ---- 通用容器 ---- */
.container {
  padding: 24rpx 28rpx 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 14% 8%, #d8e7ff 0%, transparent 38%),
    radial-gradient(circle at 88% 12%, #dff4ff 0%, transparent 34%),
    #eef3f9;
}

/* ---- 卡片 ---- */
.card {
  background: #fff;
  border: 1rpx solid #d7deea;
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(14, 39, 84, 0.08);
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin: 0;
}
.btn-primary {
  background: linear-gradient(90deg, #1677ff, #2f88ff);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(22, 119, 255, 0.22);
}
.btn-ghost {
  background: #edf3ff;
  color: #24436f;
  border: 1rpx solid #c6d8ff;
}
.btn-danger {
  background: linear-gradient(90deg, #d63f0f, #ea5419);
  color: #fff;
}
.btn-sm {
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
}
.btn[disabled] { opacity: 0.5; }

/* ---- 状态徽章 ---- */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge-pending  { background: #fff7e0; color: #b87800; border: 1rpx solid #ffe0a3; }
.badge-submitted { background: #edf4ff; color: #1e4f9f; border: 1rpx solid #c9dbff; }
.badge-approved  { background: #e6f7ed; color: #15803d; border: 1rpx solid #b9e7c8; }
.badge-rejected  { background: #fff0ed; color: #d4380d; border: 1rpx solid #ffc8bd; }
.badge-rectify   { background: #fff4e8; color: #b85000; border: 1rpx solid #ffd6aa; }
.badge-done      { background: #e8f8ee; color: #186028; border: 1rpx solid #b9e7c8; }

/* ---- 标签行 ---- */
.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.label-row text:first-child {
  width: 160rpx;
  color: #5e6f86;
  font-size: 26rpx;
  flex-shrink: 0;
}
.label-row text:last-child {
  flex: 1;
  font-size: 28rpx;
  color: #13223a;
}

/* ---- 错误/提示 ---- */
.error-tip { color: #d4380d; font-size: 26rpx; margin-top: 12rpx; }
.success-tip { color: #1a7a3c; font-size: 26rpx; margin-top: 12rpx; }
.hint { color: #5e6f86; font-size: 24rpx; margin-top: 8rpx; }

/* ---- 分隔线 ---- */
.divider { height: 1rpx; background: #e1e8f5; margin: 20rpx 0; }

/* ---- 底部导航条 ---- */
.nav-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #d7deea;
  display: flex;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.nav-item text { font-size: 22rpx; color: #8899bb; }
.nav-item.active text { color: #1677ff; font-weight: 600; }
.nav-icon { font-size: 40rpx; }

/* ---- 页面标题 ---- */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #13223a;
  margin-bottom: 24rpx;
}

/* ---- 输入框 ---- */
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.field-label {
  font-size: 26rpx;
  color: #5e6f86;
  margin-bottom: 8rpx;
}
.field input, .field textarea {
  background: #fff;
  border: 1rpx solid #c6d4ea;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #13223a;
}
.field textarea { height: 120rpx; }

/* ---- 选项组 ---- */
.option-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 8rpx;
}
.option-btn {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #edf3ff;
  color: #24436f;
  border: 1rpx solid #c6d8ff;
}
.option-btn.selected {
  background: #1677ff;
  color: #fff;
  border-color: #1677ff;
}
