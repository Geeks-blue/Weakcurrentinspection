<scroll-view scroll-y style="height:100vh">
<view class="container">
  <view class="page-title">派发巡检任务</view>

  <view class="loading-tip" wx:if="{{loading}}">加载选项中...</view>

  <!-- 任务基础信息 -->
  <view class="card">
    <view class="section-title">任务信息</view>
    <view class="field">
      <text class="field-label">任务标题</text>
      <input class="d-input" value="{{taskTitle}}" bindinput="onTitleInput" />
    </view>
    <view class="field">
      <text class="field-label">巡检周期</text>
      <picker mode="selector" range="{{cycleLabels}}" bindchange="onCycleChange">
        <view class="d-input picker-val">{{cycleLabels[cycleOptions.indexOf(cycleType)]}} ▾</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">截止日期</text>
      <picker mode="date" value="{{dueDate}}" bindchange="onDueDateChange">
        <view class="d-input picker-val">{{dueDate || '选择日期'}} ▾</view>
      </picker>
    </view>
  </view>

  <!-- 选择房间 -->
  <view class="card">
    <view class="sel-head">
      <text class="section-title">选择房间（已选 {{selectedRoomIds.length}} 间）</text>
      <view class="sel-btns">
        <text class="sel-btn" bindtap="selectAllRooms">全选</text>
        <text class="sel-btn" bindtap="clearRooms">清空</text>
      </view>
    </view>
    <input class="search-input" placeholder="搜索房间" value="{{roomFilter}}" bindinput="onRoomFilter" />
    <scroll-view scroll-y style="max-height:400rpx;margin-top:12rpx">
      <view
        class="sel-item {{item.selected ? 'sel-active' : ''}}"
        wx:for="{{displayRooms}}"
        wx:key="room_id"
        data-id="{{item.room_id}}"
        bindtap="toggleRoom"
      >
        <text class="sel-code">{{item.room_code}}</text>
        <text class="sel-sub">{{item.buildingLabel}}</text>
        <text class="sel-check" wx:if="{{item.selected}}">✓</text>
      </view>
      <view class="empty-inline" wx:if="{{displayRooms.length === 0}}">没有匹配的房间</view>
    </scroll-view>
  </view>

  <!-- 选择学生 -->
  <view class="card">
    <text class="section-title">选择学生（已选 {{selectedStudentIds.length}} 人）</text>
    <input class="search-input" placeholder="搜索学生" value="{{studentFilter}}" bindinput="onStudentFilter" />
    <view
      class="sel-item {{item.selected ? 'sel-active' : ''}}"
      wx:for="{{displayStudents}}"
      wx:key="student_user_id"
      data-id="{{item.student_user_id}}"
      bindtap="toggleStudent"
    >
      <text class="sel-code">{{item.username}}</text>
      <text class="sel-sub">{{item.genderLabel}}</text>
      <text class="sel-check" wx:if="{{item.selected}}">✓</text>
    </view>
    <view class="empty-inline" wx:if="{{displayStudents.length === 0}}">没有匹配的学生</view>
  </view>

  <text class="error-tip" wx:if="{{error}}">{{error}}</text>
  <text class="success-tip" wx:if="{{message}}">{{message}}</text>

  <button
    class="btn btn-primary"
    loading="{{dispatching}}"
    disabled="{{dispatching}}"
    bindtap="onDispatch"
  >{{dispatching ? '派发中...' : '🚀 一键均分派发'}}</button>

  <!-- 底部导航 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="goBack">
      <text class="nav-icon">📝</text><text>待审核</text>
    </view>
    <view class="nav-item">
      <text class="nav-icon">📊</text><text>记录总览</text>
    </view>
    <view class="nav-item active">
      <text class="nav-icon">📤</text><text>派发任务</text>
    </view>
  </view>
</view>
</scroll-view>
