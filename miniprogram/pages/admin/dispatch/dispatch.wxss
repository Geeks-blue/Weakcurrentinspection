.loading-tip { text-align:center; color:#5e6f86; font-size:28rpx; margin-top:60rpx; }
.d-input {
  background:#fff; border:1rpx solid #c6d4ea; border-radius:12rpx;
  padding:16rpx 18rpx; font-size:28rpx; color:#13223a;
}
.picker-val { color:#1677ff; }
.sel-head { display:flex; align-items:center; justify-content:space-between; }
.sel-btns { display:flex; gap:16rpx; }
.sel-btn { font-size:24rpx; color:#1677ff; }
.search-input {
  background:#fff; border:1rpx solid #c6d4ea; border-radius:10rpx; padding:12rpx 16rpx;
  font-size:26rpx; margin-bottom:8rpx; width:100%; box-sizing:border-box;
}
.sel-item {
  display:flex; align-items:center; padding:14rpx 12rpx;
  border-bottom:1rpx solid #e1e8f5; gap:12rpx;
}
.sel-item.sel-active { background:#edf3ff; }
.sel-code { font-size:28rpx; font-weight:700; color:#13223a; flex:1; }
.sel-sub { font-size:24rpx; color:#5e6f86; }
.sel-check { font-size:28rpx; color:#1677ff; font-weight:700; }
.empty-inline { padding: 24rpx 0; text-align: center; color: #5e6f86; font-size: 24rpx; }
