.loading-tip { text-align:center; color:#8899bb; font-size:28rpx; margin-top:60rpx; }
.d-input {
  background:#f4f8ff; border:1rpx solid #c8d8f0; border-radius:12rpx;
  padding:16rpx 18rpx; font-size:28rpx; color:#1e3060;
}
.picker-val { color:#1a3a6e; }
.sel-head { display:flex; align-items:center; justify-content:space-between; }
.sel-btns { display:flex; gap:16rpx; }
.sel-btn { font-size:24rpx; color:#2a5cc8; }
.search-input {
  background:#f0f4ff; border-radius:10rpx; padding:12rpx 16rpx;
  font-size:26rpx; margin-bottom:8rpx; width:100%; box-sizing:border-box;
}
.sel-item {
  display:flex; align-items:center; padding:14rpx 12rpx;
  border-bottom:1rpx solid #edf3ff; gap:12rpx;
}
.sel-item.sel-active { background:#edf3ff; }
.sel-code { font-size:28rpx; font-weight:600; color:#1a3a6e; flex:1; }
.sel-sub { font-size:24rpx; color:#8899bb; }
.sel-check { font-size:28rpx; color:#2a5cc8; font-weight:700; }
