.loading-tip, .empty-tip { text-align:center; color:#5e6f86; font-size:28rpx; margin-top:60rpx; }
.filter-card { padding:20rpx 24rpx; }
.filter-row { display:flex; align-items:center; margin-bottom:14rpx; }
.filter-label { width:100rpx; font-size:26rpx; color:#5e6f86; flex-shrink:0; }
.filter-val { font-size:26rpx; color:#1677ff; padding:10rpx 0; }
.filter-input { flex:1; font-size:26rpx; color:#13223a; border-bottom:1rpx solid #d7deea; padding:8rpx 0; }
.rec-card { padding:20rpx 24rpx; }
.rec-head { display:flex; align-items:flex-start; justify-content:space-between; }
.rec-room { font-size:28rpx; font-weight:700; color:#13223a; display:block; }
.expand-icon { color:#5e6f86; font-size:22rpx; }
.photo-strip { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:12rpx; }
.photo-sm { width:130rpx; height:100rpx; border-radius:8rpx; }
