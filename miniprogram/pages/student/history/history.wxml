<view class="container">
  <view class="page-title">我的巡检记录</view>
  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  <text class="error-tip" wx:elif="{{error}}">{{error}}</text>
  <view class="empty-tip" wx:elif="{{records.length === 0 && !loading}}">暂无巡检记录</view>

  <view class="card" wx:for="{{records}}" wx:key="inspection_id">
    <view class="rec-head">
      <view>
        <text class="rec-room">{{item.building_code}} / {{item.room_code}}</text>
        <text class="hint">{{item.dateStr}}</text>
      </view>
      <view class="badge {{item.statusClass}}">{{item.statusLabel}}</view>
    </view>
    <view class="divider"></view>
    <view class="label-row"><text>锁闭</text><text>{{item.lockLabel}}</text></view>
    <view class="label-row"><text>杂物</text><text>{{item.clutterLabel}}</text></view>
    <view class="label-row"><text>指示灯</text><text>{{item.indicatorLabel}}</text></view>
    <view class="label-row"><text>资产</text><text>{{item.assetLabel}}</text></view>
    <view class="photo-strip" wx:if="{{item.photo_urls.length > 0}}">
      <image
        wx:for="{{item.photo_urls}}"
        wx:for-item="url"
        wx:key="url"
        src="{{url}}"
        mode="aspectFill"
        class="photo-thumb"
        data-urls="{{item.photo_urls}}"
        data-current="{{url}}"
        bindtap="onPreviewPhoto"
      />
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="goTasks">
      <text class="nav-icon">📋</text>
      <text>任务</text>
    </view>
    <view class="nav-item active">
      <text class="nav-icon">📁</text>
      <text>记录</text>
    </view>
  </view>
</view>
