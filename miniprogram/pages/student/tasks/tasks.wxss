.top-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.logout-btn {
  font-size: 26rpx;
  color: #5e6f86;
  padding: 8rpx 0;
}
.search-wrap { padding: 16rpx 20rpx; margin-bottom: 20rpx; }
.search-input {
  font-size: 28rpx;
  color: #13223a;
}
.loading-tip, .empty-tip {
  text-align: center;
  color: #5e6f86;
  font-size: 28rpx;
  margin-top: 80rpx;
}
.task-card { padding: 24rpx 24rpx; cursor: pointer; }
.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.task-title { font-size: 30rpx; font-weight: 700; color: #13223a; flex: 1; }
.task-room {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #1677ff;
  margin-bottom: 8rpx;
}
.room-icon { font-size: 28rpx; }
.task-due {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.go-arrow { color: #1677ff; font-size: 28rpx; }
